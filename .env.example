# Copie para .env e preencha. O .env NÃO vai para o Git.

# ============================ MODO DE EXECUÇÃO ============================
# teste    -> TODOS os e-mails vão para EMAIL_DESTINO_TESTE, assunto com [TESTE], no máx. 5 por execução
# producao -> envia para os beneficiários reais (exige CONFIRMAR_PRODUCAO=sim)
MODO=teste
EMAIL_DESTINO_TESTE=seu.email@empresa.com
# CONFIRMAR_PRODUCAO=sim

# exemplo -> dados fictícios (não acessa os bancos)  |  banco -> bancos reais via SSH
FONTE_DADOS=exemplo

# ============================ ENVIO DE E-MAIL ============================
# console (só simula, não envia) | smtp (SES via SMTP) | brevo | ses (SES via API)
PROVEDOR_EMAIL=console
REMETENTE_EMAIL=remetente.verificado@empresa.com
REMETENTE_NOME=Financeiro
RESPONDER_PARA=
# Aparece no texto dos e-mails (canal "E-mail" de atendimento). Obrigatório em produção.
EMAIL_ATENDIMENTO=

# Brevo (testes): Settings > SMTP & API > API Keys
BREVO_API_KEY=

# Amazon SES via SMTP (PROVEDOR_EMAIL=smtp): usuário/senha SMTP gerados no SES
# 587 = STARTTLS | 465 = TLS direto (SMTP_SEGURANCA é deduzido da porta)
SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# Amazon SES via API (PROVEDOR_EMAIL=ses): credenciais padrão do boto3
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# ============================ REGRAS DA RÉGUA ============================
MARCOS=15:aviso,30:suspensao,60:cancelamento
MOVIMENTOS=EM_NEGOCIACAO
# Os textos de 30 e 60 dias só AVISAM (será suspenso/cancelado): não dependem do ERP.
# Para exigir a situação no ERP antes de cada carta: suspensao:SUSPENSO,cancelamento:CANCELADO
SITUACAO_EXIGIDA=
# As 3 cartas saem em sequência. Dias mínimos entre uma carta e a próxima
# (vazio = distância natural entre os marcos: 15 dias até a 2ª, 30 dias até a 3ª)
INTERVALO_ENTRE_CARTAS_DIAS=
# Situações que nunca recebem nada (vazio = nenhuma)
SITUACOES_PLANO_IGNORAR=
# Ignora quem passou de X dias (útil na 1ª execução, para não disparar cancelamento para dívidas antigas)
DIAS_ATRASO_MAXIMO=
# Vazio = sem limite em produção; em teste o padrão é 5
MAX_ENVIOS_POR_EXECUCAO=
PAUSA_ENTRE_ENVIOS=0.2
MAX_TENTATIVAS=3

# ============================ BANCO DE CONTROLE ============================
# Onde fica o registro de quem recebeu o quê. As tabelas são criadas sozinhas.
# Na sua máquina (sem instalar nada): arquivo SQLite na pasta do projeto, abre no DBeaver
CONTROLE_DB_URL=sqlite:///controle_regua.db
# Em produção / Docker: PostgreSQL
# CONTROLE_DB_URL=postgresql+psycopg2://regua:regua@localhost:55432/regua

# ============================ BANCOS DE ORIGEM (FONTE_DADOS=banco) ============================
# Mesmas variáveis do script de extração. Dentro do Docker a chave fica em /secrets.
FINANCEIRO_SSH_HOST=jump.maida.health
FINANCEIRO_SSH_USER=lucas.castro
# Sem Docker: caminho no Windows (ex.: C:/Users/temporario/.ssh/lucas_castro.pem) | Docker: /secrets/...
FINANCEIRO_SSH_KEY_PATH=C:/Users/temporario/.ssh/lucas_castro.pem
FINANCEIRO_DB_HOST=df-financeiro-api-db-live.maida.health
FINANCEIRO_DB_PORT=5432
FINANCEIRO_DB_NAME=df_financeiro_api_live
FINANCEIRO_DB_USER=
FINANCEIRO_DB_PASSWORD=
FINANCEIRO_DB_SSLMODE=require

CONTRATO_SSH_HOST=
CONTRATO_SSH_USER=
CONTRATO_SSH_KEY_PATH=C:/Users/temporario/.ssh/chave_contrato.pem
CONTRATO_DB_HOST=
CONTRATO_DB_PORT=5432
CONTRATO_DB_NAME=df_contrato_api
CONTRATO_DB_USER=
CONTRATO_DB_PASSWORD=

# Banco PESSOA: de onde vem o e-mail do beneficiário (tabela pessoa, cruzando pelo CPF)
# Se for pelo mesmo jump/chave do contrato, repita os mesmos valores de SSH.
PESSOA_SSH_HOST=
PESSOA_SSH_USER=
PESSOA_SSH_KEY_PATH=C:/Users/temporario/.ssh/chave_contrato.pem
PESSOA_DB_HOST=
PESSOA_DB_PORT=5432
PESSOA_DB_NAME=
PESSOA_DB_USER=
PESSOA_DB_PASSWORD=
PESSOA_DB_SSLMODE=

# Nomes de tabelas/colunas
PESSOA_TABELA=pessoa
PESSOA_COLUNA_CPF=cpf_cnpj
# Coluna de e-mail na tabela pessoa
COLUNA_EMAIL=email
COLUNA_SITUACAO_PLANO=situacao
COLUNA_VENCIMENTO=data_vencimeto

# ============================ LOGS ============================
# texto (local) | json (Cloud Run / Cloud Logging)
LOG_FORMATO=texto
